# Variáveis de ambiente do projeto (somente uso local).
# Copie para `.env.local` com `npm run env:init` (ele gera o BETTER_AUTH_SECRET).
# Nunca commite o `.env.local` nem segredos reais.

# Segredo do Better Auth (mínimo de 32 caracteres). O valor abaixo é um
# placeholder inválido de propósito: `npm run env:init` o troca por um segredo aleatório.
BETTER_AUTH_SECRET=troque-por-npm-run-env-init

# URL base da aplicação (usada pelo Better Auth para links e origem confiável).
BETTER_AUTH_URL=http://localhost:3000

# Conexão com o MySQL de desenvolvimento (usuário e senha do docker-compose.yml).
DATABASE_URL=mysql://auth:auth_dev_password@127.0.0.1:3306/auth_dev

# Conexão com o MySQL de testes (banco `auth_test`, no mesmo contêiner).
# Usada só por ferramentas (Vitest, Playwright); não é lida por lib/env.ts.
DATABASE_URL_TEST=mysql://auth:auth_dev_password@127.0.0.1:3306/auth_test

# Servidor SMTP de desenvolvimento (Mailpit; interface em http://localhost:8025).
SMTP_HOST=127.0.0.1
SMTP_PORT=1025

# Remetente dos e-mails transacionais.
EMAIL_FROM=Autenticação <nao-responder@localhost>

# Provedor de e-mail: `smtp` envia pelo SMTP acima.
EMAIL_PROVIDER=smtp

# Provedor de SMS: `console` escreve o SMS no log (inclui o texto, que pode ter OTP;
# use apenas em ambiente local).
SMS_PROVIDER=console
